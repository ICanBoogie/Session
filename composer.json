{
  "name": "icanboogie/session",
  "type": "library",
  "description": "Manage sessions",
  "keywords": [
    "session"
  ],
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/Session/issues",
    "source": "https://github.com/ICanBoogie/Session"
  },
  "config": {
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "ICanBoogie\\": "lib/",
      "ICanBoogie\\Session\\": "lib/Session"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ICanBoogie\\": "tests"
    }
  }
}
